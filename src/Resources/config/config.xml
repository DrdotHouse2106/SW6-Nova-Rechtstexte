<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Placeholders per sales channel</title>
        <title lang="de-DE">Platzhalter je Verkaufskanal</title>

        <input-field type="bool">
            <name>disabled</name>
            <label>Do not replace placeholders</label>
            <label lang="de-DE">Platzhalter NICHT ersetzen</label>
            <helpText>Text elements in shopping experiences may contain placeholders such as [[Shopname]], [[E-Mail]], [[Telefon]], [[Telefax]], [[WhatsApp]], [[Firma]], [[Inhaber]], [[USt-IdNr]], [[Lieferzeit]], [[Versandkosten]], [[Domain]], [[Shop-URL]], [[Jahr]], [[Zusatz1]]–[[Zusatz3]]. They are replaced per sales channel – so one legal text layout can be used in all shops. Shop name and e-mail come from Settings → Basic information.</helpText>
            <helpText lang="de-DE">Texte in Erlebniswelten dürfen Platzhalter enthalten: [[Shopname]], [[E-Mail]], [[Telefon]], [[Telefax]], [[WhatsApp]], [[Firma]], [[Inhaber]], [[USt-IdNr]], [[Lieferzeit]], [[Versandkosten]], [[Domain]], [[Shop-URL]], [[Jahr]], [[Zusatz1]] bis [[Zusatz3]]. Sie werden je Verkaufskanal ersetzt – so reicht EIN Layout je Rechtstext für alle Shops. Shopname und E-Mail kommen aus Einstellungen → Grundinformationen (E-Mail hier überschreibbar). Werte unter „Alle Verkaufskanäle“ gelten für jeden Shop ohne eigenen Wert. Nach Änderungen den Cache leeren.</helpText>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="text">
            <name>email</name>
            <label>[[E-Mail]] (optional)</label>
            <label lang="de-DE">[[E-Mail]] (optional)</label>
            <helpText>Empty = e-mail from Basic information.</helpText>
            <helpText lang="de-DE">Leer = E-Mail-Adresse aus den Grundinformationen des Verkaufskanals.</helpText>
        </input-field>

        <input-field type="text">
            <name>phone</name>
            <label>[[Telefon]]</label>
            <label lang="de-DE">[[Telefon]]</label>
            <placeholder>+49 6403 72201</placeholder>
            <helpText>Empty = phone number of the top bar.</helpText>
            <helpText lang="de-DE">Leer = Telefonnummer aus der Topbar (Nova Theme), falls vorhanden.</helpText>
        </input-field>

        <input-field type="text">
            <name>fax</name>
            <label>[[Telefax]]</label>
            <label lang="de-DE">[[Telefax]]</label>
        </input-field>

        <input-field type="text">
            <name>whatsapp</name>
            <label>[[WhatsApp]]</label>
            <label lang="de-DE">[[WhatsApp]]</label>
        </input-field>

        <input-field type="text">
            <name>company</name>
            <label>[[Firma]]</label>
            <label lang="de-DE">[[Firma]]</label>
            <placeholder>FranceTec Marcel Ulber</placeholder>
            <helpText lang="de-DE">Firmierung für Impressum, AGB, Widerruf. Leer = Shopname.</helpText>
            <helpText>Company name for imprint and terms. Empty = shop name.</helpText>
        </input-field>

        <input-field type="text">
            <name>owner</name>
            <label>[[Inhaber]]</label>
            <label lang="de-DE">[[Inhaber]]</label>
            <placeholder>Marcel Ulber</placeholder>
            <helpText lang="de-DE">Inhaber bzw. Verantwortlicher (Impressum, Datenschutz, Widerruf). Unter „Alle Verkaufskanäle“ einmal setzen.</helpText>
            <helpText>Owner / controller. Set once under "All sales channels".</helpText>
        </input-field>

        <input-field type="textarea">
            <name>address</name>
            <label>[[Anschrift]]</label>
            <label lang="de-DE">[[Anschrift]]</label>
            <placeholder>Musterstraße 1
12345 Musterstadt
Deutschland</placeholder>
            <helpText lang="de-DE">Ladungsfähige Anschrift, eine Angabe pro Zeile. Wird in Impressum, AGB, Widerruf und Datenschutz der Vorlagen verwendet.</helpText>
            <helpText>Postal address, one item per line.</helpText>
        </input-field>

        <input-field type="textarea">
            <name>supervisoryAuthority</name>
            <label>[[Aufsichtsbehörde]] (HTML allowed)</label>
            <label lang="de-DE">[[Aufsichtsbehörde]] (HTML erlaubt)</label>
            <helpText lang="de-DE">Für Sie zuständige Datenschutz-Aufsichtsbehörde (Bundesland Ihres Sitzes) mit Anschrift, eine Angabe pro Zeile – für die Vorlage Datenschutzerklärung.</helpText>
            <helpText>Data protection supervisory authority responsible for you.</helpText>
        </input-field>

        <input-field type="text">
            <name>erpProvider</name>
            <label>[[Warenwirtschaft]]</label>
            <label lang="de-DE">[[Warenwirtschaft]]</label>
            <placeholder>weclapp GmbH, Friedrich-Ebert-Straße 28, 97318 Kitzingen</placeholder>
            <helpText lang="de-DE">Anbieter Ihres externen Warenwirtschafts-/ERP-Systems mit Anschrift (Baustein „Warenwirtschaft“ in der Datenschutzerklärung).</helpText>
            <helpText>Provider of your external ERP system with address.</helpText>
        </input-field>

        <input-field type="text">
            <name>vatId</name>
            <label>[[USt-IdNr]]</label>
            <label lang="de-DE">[[USt-IdNr]]</label>
        </input-field>

        <input-field type="text">
            <name>deliveryTime</name>
            <label>[[Lieferzeit]]</label>
            <label lang="de-DE">[[Lieferzeit]]</label>
            <placeholder>3 - 5 Tagen</placeholder>
            <helpText lang="de-DE">Für „Zahlung und Versand“, z. B. „3 - 5 Tagen“ oder „1 - 3 Werktagen“.</helpText>
            <helpText>E.g. "3 - 5 days".</helpText>
        </input-field>

        <input-field type="textarea">
            <name>shipping</name>
            <label>[[Versandkosten]] by hand (HTML allowed)</label>
            <label lang="de-DE">[[Versandkosten]] von Hand (HTML erlaubt)</label>
            <helpText lang="de-DE">LEER LASSEN = Versandkosten werden automatisch aus den Versandarten des Verkaufskanals erzeugt (Preise, Gewichtsstufen, Regeln, Lieferzeit) – so stimmen Text und Checkout immer überein. Nur ausfüllen, wenn ein eigener Text gewünscht ist. Die automatische Tabelle gibt es zusätzlich immer als [[Versandkosten automatisch]].</helpText>
            <helpText>Leave EMPTY = generated automatically from the sales channel's shipping methods. Also always available as [[Versandkosten automatisch]].</helpText>
        </input-field>

        <component name="sw-entity-multi-id-select">
            <name>shippingHidden</name>
            <entity>shipping_method</entity>
            <label>Automatic shipping table: hide these shipping methods</label>
            <label lang="de-DE">Automatische Versandkosten: diese Versandarten nicht aufführen</label>
        </component>

        <input-field type="bool">
            <name>shippingShowRules</name>
            <label>Automatic shipping table: show rule names (e.g. "Germany")</label>
            <label lang="de-DE">Automatische Versandkosten: Regelnamen zeigen (z. B. „Deutschland“)</label>
            <helpText lang="de-DE">Als „Gilt für“ erscheint die erste Zeile der Regel-BESCHREIBUNG aus dem Rule Builder (z. B. „EU-Zone 1: Österreich, Belgien …“), sonst der Regelname. Beschreibung „-“ = Preise dieser Regel nicht aufführen (z. B. Sonderregeln für einzelne Artikel). So bleiben die internen Regelnamen unverändert.</helpText>
            <helpText>Rule names appear as "applies to" – name them in customer-friendly terms.</helpText>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>shippingShowDeliveryTime</name>
            <label>Automatic shipping table: show delivery time</label>
            <label lang="de-DE">Automatische Versandkosten: Lieferzeit zeigen</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="textarea">
            <name>extra1</name>
            <label>[[Zusatz1]] (free, HTML allowed)</label>
            <label lang="de-DE">[[Zusatz1]] (frei, HTML erlaubt)</label>
            <helpText lang="de-DE">Freier Text je Shop, z. B. ein Absatz, der nur in einem Shop gilt. Leer = Platzhalter verschwindet.</helpText>
            <helpText>Free text per shop. Empty = placeholder disappears.</helpText>
        </input-field>

        <input-field type="textarea">
            <name>extra2</name>
            <label>[[Zusatz2]] (free, HTML allowed)</label>
            <label lang="de-DE">[[Zusatz2]] (frei, HTML erlaubt)</label>
        </input-field>

        <input-field type="textarea">
            <name>extra3</name>
            <label>[[Zusatz3]] (free, HTML allowed)</label>
            <label lang="de-DE">[[Zusatz3]] (frei, HTML erlaubt)</label>
        </input-field>
    </card>
